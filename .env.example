# cp .env.example .env
# FRED (free key: https://fred.stlouisfed.org/docs/api/api_key.html) enables the credit-spread, labour, CPI and
# Fed-balance-sheet panels. Leave empty and those panels show "add FRED key"; everything else still works.
FRED_API_KEY=

# Where the transcript .txt files live on the host (one <video_id>.txt per episode, lines like "[123] text").
# Mounted read-only. New files are indexed automatically (every TRANSCRIPT_SCAN_MINUTES).
TRANSCRIPTS_HOST_PATH=./transcripts

WEB_PORT=8080
# 127.0.0.1 = this machine only. Use 0.0.0.0 to expose on your LAN (there is no login - do not expose publicly).
BIND_ADDR=127.0.0.1
TZ=America/Toronto
# 1 = default refresh cadence; 2 = half as often (be gentle to free APIs)
REFRESH_SCALE=1
TRANSCRIPT_SCAN_MINUTES=5
